@startuml
start
:Alumno solicita información
sobre los cursos;
if (ya se dictaron 4 clases?) then (sí)
	:Explicar a Alumno que ya no puede
	inscribirse e invitarlo a inscribirse
	en el próximo cuatrimestre;
	end
else (todavía no)
endif

if (Ya se dictaron 3 clases?) then (sí)
	:Explicar a alumno que tendrá 3
	inasistencias y el máximo son 4;
else (todavía no)
endif
:Enviar información sobre cursos;
end
@enduml
